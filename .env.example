# Local settings for ChatGPT Quick Register. Copy to `.env` (git-ignored) and edit.
# The WebUI「设置」page reads and writes these same keys, so you rarely edit this by hand.

# --- 数据库 / 账号加密 ---
QR_MYSQL_HOST=127.0.0.1
QR_MYSQL_PORT=3306
QR_MYSQL_USER=root
QR_MYSQL_PASSWORD=
QR_MYSQL_DATABASE=quick_register
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
QR_ACCOUNT_ENCRYPTION_KEY=REPLACE_WITH_A_FRESH_FERNET_KEY

# --- 邮箱设置 ---
QR_MHJC_API_BASE=
# 自定义邮箱用户名（只能用一次）；留空则按下方的命名方式生成
QR_MHJC_USERNAME=
# 留空用户名时的命名方式：name=随机英文姓名（如 emma.wilson，默认）；provider=服务商默认 temp_xxxx
QR_MHJC_NAME_STYLE=name
QR_QQ_USER=
QR_ICLOUD_HOST=
QR_ICLOUD_FETCH_MODE=
QR_DUCK_BASE_URL=

# --- 凭证 ---
QR_DUCK_TOKEN=
QR_MHJC_API_KEY=
QR_QQ_PASS=

# --- 短信设置 / Codex OAuth 自动接码 ---
QR_FIVESIM_API_KEY=
QR_FIVESIM_COUNTRY=any
QR_FIVESIM_OPERATOR=any
QR_FIVESIM_PRODUCT=openai
# 留空表示不限单价；每次手机号验证最多发出 3 次购买请求
QR_FIVESIM_MAX_PRICE=
QR_FIVESIM_ACQUIRE_PRIORITY=rate
QR_FIVESIM_CANDIDATE_LIMIT=8
# 1 使用浏览器代理；0 仅让 5sim API 直连（默认 0：实测直连约 0.5s/次，走代理约 3s/次）
QR_FIVESIM_USE_PROXY=0
# 已选供应商（顺序=购买优先级，在「短信设置 → 查询价格」里勾选保存）
# 例：QR_FIVESIM_PROVIDERS=[{"country":"usa","operator":"virtual21"},{"country":"poland","operator":"virtual66"}]
# 只在这些供应商里买号；某个买不到就自动切到下一个优先级。留空 [] 表示沿用上面的国家/运营商
QR_FIVESIM_PROVIDERS=[]
# 1 = 已选供应商全部买不到时才允许换到其它供应商；0 = 只在已选列表里选号（默认）
QR_FIVESIM_ALLOW_OTHER_PROVIDERS=0
# 等待 5sim 短信的轮询间隔（秒），越小越快但请求更频繁
QR_FIVESIM_POLL_INTERVAL=2

# --- 浏览器指纹（每次注册一套，默认开启） ---
# stealth=内置纯 Playwright 指纹层（默认，不需要任何外部指纹浏览器）；off=关闭
QR_FINGERPRINT_BROWSER=stealth
# 可选：固定指纹画像的地区/平台（留空=每次随机），如 QR_FINGERPRINT_REGION=JP、QR_FINGERPRINT_PLATFORM=windows
QR_FINGERPRINT_REGION=
QR_FINGERPRINT_PLATFORM=

# --- 高级设置 ---
QR_QQ_MAX_ATTEMPTS=
QR_QQ_INTERVAL=
QR_ICLOUD_LOGIN_TIMEOUT=
QR_AC_CHECKER_BASE_URL=
QR_AC_CHECKER_PROMO_ID=
QR_PAY153_BASE_URL=
# 浏览器窗口/标签页在注册中途被关掉（或 Chrome 崩溃）时，自动重开浏览器重试的次数（默认 1）
# 重试会复用同一个邮箱，不会重复建邮箱；0 = 关闭该保护
QR_BROWSER_RETRY=1
# 首页被 Cloudflare 托管挑战拦住（标题会被本地化成 "รอสักครู่..." / "Just a moment..." 等）时
# 等待其自动放行的秒数（默认 180）。这台机器+当前代理实测 30~115s 放行；0 = 不等直接失败
QR_CLOUDFLARE_TIMEOUT=180

# --- 代理设置 ---
QR_PROXY_SCHEME=
QR_PROXY_HOST=
QR_PROXY_PORT=
QR_PROXY_USER=
QR_PROXY_PASSWORD=
QR_PROXY=
QR_PROXY_INSECURE=

# --- SUB2API 推送目标（账号页「Codex 登录并推送」使用） ---
# 鉴权优先用管理员 API Key（请求头 x-api-key），在 SUB2API 后台生成
QR_SUB2API_BASE_URL=
QR_SUB2API_ADMIN_API_KEY=
# 仅当后台未启用管理员 API Key 时，才用管理员邮箱+密码走 JWT 兜底
QR_SUB2API_ADMIN_EMAIL=
QR_SUB2API_ADMIN_PASSWORD=
QR_SUB2API_GROUP_NAME=codex
QR_SUB2API_CONCURRENCY=5
QR_SUB2API_PRIORITY=1
QR_SUB2API_RATE_MULTIPLIER=1
QR_SUB2API_PRIVACY_MODE=training_off

# --- 封禁检测 ---
# ban-scan 回看邮件的天数（默认 30）
QR_BAN_SINCE_DAYS=30
